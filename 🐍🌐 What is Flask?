You can create pages such as:

/
├── Home
├── /courses
├── /admissions
├── /contact
└── /chatbot

======

Example:

from flask import Flask


app = Flask(__name__)


@app.route("/")
def home():
    return "Welcome to Bright Future College"


@app.route("/courses")
def courses():
    return "BCA, BBA, MBA, Computer Science"


@app.route("/admissions")
def admissions():
    return "Admissions are now open!"


if __name__ == "__main__":
    app.run(debug=True)

